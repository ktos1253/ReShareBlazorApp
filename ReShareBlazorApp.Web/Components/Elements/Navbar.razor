@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
<nav class="main-navbar">
    <div class="main-navbar-container">
        <a class="main-navbar-brand" href="/">Navbar</a>

        <ul class="main-navbar-links">
            <li class="main-navbar-item">
                <a class="main-navbar-link active" href="/str">Home</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link active" href="/przegladaj">Odkrywaj</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link active" href="/wiadomosci">Wiadomości</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link active" href="/profil">Profil</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link active" href="/login">Zaloguj się</a>
            </li>
        </ul>

        <form class="navbar-search" role="search">
            <input class="navbar-search-input"
                   type="search"
                   placeholder="Search"
                   aria-label="Search" />

            <button class="navbar-search-button" type="submit">
                <svg width="18" height="18">
                    <use href="#search" />
                </svg>
            </button>
            <AuthorizeView>
                <Authorized Context="auth">
                    <p>@auth.User.FindFirst(ClaimTypes.Email)?.Value</p>
                </Authorized>
            </AuthorizeView>
        </form>
    </div>
</nav>